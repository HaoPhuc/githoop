# Optional: real GitHub GraphQL scouting. Sample profiles work without a token.
GITHUB_TOKEN=
# Optional comma-separated token pool for higher traffic.
GITHUB_TOKENS=

# Optional: shared card cache, scout counter, leaderboards and saved rosters.
# Merging accounts and seeding the leaderboard need it.
REDIS_URL=

# Optional: unlocks /api/cron/seed, which fills the leaderboard from GitHub's
# follower ranking. The route stays shut without it.
CRON_SECRET=

# Set to your deployment's origin before building for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional monitoring. Leave empty to keep it disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
